# ---- Server ----
# SQLite local database file (no server needed). Prisma will create it on migrate.
DATABASE_URL="file:./dev.db"

# JWT signing secret — generate a long random value for production
JWT_SECRET="change-me-in-production-use-a-64-char-random-string"
JWT_EXPIRES_IN="2h"

# Master data-encryption key (base64 of 32 random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, load this from a secret manager, NOT from a file.
DATA_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTES"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ---- Client ----
VITE_API_URL="http://localhost:4000"

# ---- Server ----
# Database. Locally a SQLite file is fine as-is (Prisma creates it on migrate).
# Hosted (Render + Neon): paste Neon's DIRECT connection string instead, e.g.
#   postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# The Prisma schema/migrations are picked automatically from the URL (scripts/prisma.mjs).
DATABASE_URL="file:./dev.db"

# JWT signing secret — generate a long random value for production
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-in-production-use-a-64-char-random-string"
JWT_EXPIRES_IN="2h"

# Master data-encryption key (base64 of 32 random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, load this from your host's secret manager, NOT from a file.
DATA_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTES"

# Server
PORT=4000
NODE_ENV=development
# Same-origin in production (server serves the SPA), so CORS is unused there.
# Set to your deployed URL only if you host the client separately.
# Accepts a comma-separated list.
CORS_ORIGIN="http://localhost:5173"

# Extra allowed origins, comma-separated. The Android app's WebView origins
# (https://localhost, http://localhost, capacitor://localhost) are always
# allowed, so you only need this for additional web front-ends.
# CORS_EXTRA_ORIGINS=""

# Where encrypted file bytes live:
#   disk — STORAGE_DIR (default server/storage). Needs a persistent disk.
#   db   — the Blob table, next to the metadata. Use on hosts without a disk (Render free).
# Default: "disk" for a SQLite file URL, "db" otherwise.
# BLOB_STORAGE="db"
# STORAGE_DIR="/data/storage"

# Set to "true" to reopen the register endpoint after the first account exists.
# Leave unset on a public deploy so nobody else can sign up.
# ALLOW_REGISTRATION="false"

# ---- Client ----
# Dev only. The production build uses client/.env.production (VITE_API_URL=/api).
VITE_API_URL="http://localhost:4000/api"

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default. Lockly is self-hosted and the
  user picks the server address at runtime, which is commonly a plain-http
  machine on their own LAN (e.g. http://192.168.1.20:4000) with no certificate.
  There is no way to express "private address ranges" here — domain-config only
  matches literal hosts — so cleartext is permitted and the app warns in the
  setup screen whenever the chosen address is not https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Lets a user-installed CA (e.g. a self-signed cert for their own
                 server) be trusted, which stock Android 7+ otherwise ignores. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
